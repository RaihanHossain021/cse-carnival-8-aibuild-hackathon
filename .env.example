# ==========================================
# CampusOS Environment Variables
# Copy this file to .env.local or .env
# ==========================================

# 1. LLM API Key (Google Gemini 3.6 Flash / 2.5 Flash)
GOOGLE_API_KEY=your_google_gemini_api_key_here
# Alternatively:
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# 2. Supabase PostgreSQL Cloud Database (Optional)
# The application automatically works 100% offline out-of-the-box using local storage.
# If provided, all additions, edits, and deletions sync live with Supabase PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Server Port
PORT=3000
